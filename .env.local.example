# ローカル開発用環境変数（1Password は不要）
#
# cp .env.local.example .env.local
# 値を編集後、npm run dev（.gitignore 済みのためコミットされません）。
#
# 1Password は本番デプロイ（GitHub Actions）にのみ使用します（.github/secrets-manifest.tsv 参照）。

UPTIMEKUMA_BASE_URL=
UPTIMEKUMA_PORTFOLIO_SLUG=

# 管理画面ログイン用（1Password共有アイテム「Supabase」の dev-project-url / dev-publishable-key を設定）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 管理画面へのログインを許可するGoogleアカウントのメールアドレス（複数指定はカンマ区切り）
ALLOWED_GOOGLE_EMAILS=

SIGNALY_LOGIN_WEBHOOK_URL=
GITHUB_TOKEN=

# 編集画面のAI生成（説明・技術スタック）用。`claude setup-token`で発行する長期トークン。
# 1Passwordの共有アイテム「Anthropic」の claude-code-oauth-token を設定。
# 未設定の場合はAI生成のみ無効化され、他の機能は動作する。
CLAUDE_CODE_OAUTH_TOKEN=
