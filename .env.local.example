# ローカル開発用環境変数（1Password は不要）
#
# cp .env.local.example .env.local
# 値を編集後、npm run dev（.gitignore 済みのためコミットされません）。
#
# 1Password は本番デプロイ（GitHub Actions）にのみ使用します（.env.tpl 参照）。

# UptimeRobot Read-Only APIキー（未設定でも起動可、System Status は空表示になる）
UPTIMEROBOT_READ_ONLY_KEY=

# Uptime Kuma のベースURL（例: Render の公開URL）とポートフォリオ/ダッシュボードそれぞれのステータスページのスラッグ（未設定でも起動可）
UPTIMEKUMA_BASE_URL=
UPTIMEKUMA_PORTFOLIO_SLUG=
UPTIMEKUMA_DASHBOARD_SLUG=

# 管理画面ログイン用パスワード（任意の文字列）
ADMIN_PASSWORD=

# セッション署名用のランダム文字列（生成例: openssl rand -hex 32）
SESSION_SECRET=

# 管理画面に表示するNextAuthアプリ。
# 未設定時も以下の5アプリが既定値として使われます。
# 新しいアプリはIDをカンマ区切りで追加し、同名のDATABASE_URLを設定します。
REGISTERED_USERS_APP_IDS=asset-manager,car-care,meisai-lab,clip-hive,subscription-lists
REGISTERED_USERS_ASSET_MANAGER_DATABASE_URL=mysql://user:password@127.0.0.1:3306/asset_manager
REGISTERED_USERS_CAR_CARE_DATABASE_URL=mysql://user:password@127.0.0.1:3306/car_care
REGISTERED_USERS_MEISAI_LAB_DATABASE_URL=mysql://user:password@127.0.0.1:3306/meisai_lab
REGISTERED_USERS_CLIP_HIVE_DATABASE_URL=mysql://user:password@127.0.0.1:3306/clip_hive
REGISTERED_USERS_SUBSCRIPTION_LISTS_DATABASE_URL=mysql://user:password@127.0.0.1:3306/subscription_lists

# 表示名を変える場合のみ設定（未設定時はアプリIDを表示）
REGISTERED_USERS_ASSET_MANAGER_LABEL=asset-manager
REGISTERED_USERS_CAR_CARE_LABEL=car-care
REGISTERED_USERS_MEISAI_LAB_LABEL=meisai-lab
REGISTERED_USERS_CLIP_HIVE_LABEL=clip-hive
REGISTERED_USERS_SUBSCRIPTION_LISTS_LABEL=subscription-lists

# 管理画面ログイン通知（任意。未設定なら通知をスキップする）
SIGNALY_LOGIN_WEBHOOK_URL=

# GitHub APIレート制限緩和用トークン（任意。未設定でも動作する）
GITHUB_TOKEN=
