# ローカル開発用環境変数（1Password は不要）
#
# cp .env.local.example .env.local
# 値を編集後、npm run dev（.gitignore 済みのためコミットされません）。
#
# 1Password は本番デプロイ（GitHub Actions）にのみ使用します（.env.tpl 参照）。

UPTIMEROBOT_READ_ONLY_KEY=
UPTIMEKUMA_BASE_URL=
UPTIMEKUMA_PORTFOLIO_SLUG=
UPTIMEKUMA_DASHBOARD_SLUG=

ADMIN_PASSWORD=
SESSION_SECRET=

# 各アプリのUser / Account参照用（SELECT専用）
REGISTERED_USERS_DB_HOST=127.0.0.1
REGISTERED_USERS_DB_PORT=3306
REGISTERED_USERS_DB_USER=readonly_user
REGISTERED_USERS_DB_PASSWORD=change-me

# app_portfolio.RegisteredAppの作成・編集・削除用
REGISTERED_USERS_SETTINGS_DB_USER=db_user
REGISTERED_USERS_SETTINGS_DB_PASSWORD=change-me
REGISTERED_USERS_SETTINGS_DATABASE=app_portfolio

SIGNALY_LOGIN_WEBHOOK_URL=
GITHUB_TOKEN=
